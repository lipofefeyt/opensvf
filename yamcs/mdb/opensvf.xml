            </LocationInContainerInBits>
          </ParameterRefEntry>
          <ParameterRefEntry parameterRef="s20_param_value">
            <LocationInContainerInBits referenceLocation="containerStart">
              <FixedValue>152</FixedValue>
            </LocationInContainerInBits>
          </ParameterRefEntry>
        </EntryList>
      </SequenceContainer>

      <!-- TM(250,1) SVF actuator status  -  synthesised by opensvf ActuatorReporter -->
      <!-- Layout after primary(6B) + secondary(11B) = byte 17:                     -->
      <!--   mtq_dipole_x: float32 BE at bit 136                                    -->
      <!--   mtq_dipole_y: float32 BE at bit 168                                    -->
      <!--   mtq_dipole_z: float32 BE at bit 200                                    -->
      <SequenceContainer name="TM_250_1_ActuatorStatus">
        <LongDescription>MTQ dipole commands synthesised by opensvf</LongDescription>
        <BaseContainer containerRef="PUS_Packet">
          <RestrictionCriteria>
            <ComparisonList>
              <Comparison parameterRef="pus_svc"    value="250" comparisonOperator="=="/>
              <Comparison parameterRef="pus_subsvc" value="1"   comparisonOperator="=="/>
            </ComparisonList>
          </RestrictionCriteria>
        </BaseContainer>
        <EntryList>
          <ParameterRefEntry parameterRef="mtq_dipole_x">
            <LocationInContainerInBits referenceLocation="containerStart">
              <FixedValue>136</FixedValue>
            </LocationInContainerInBits>
          </ParameterRefEntry>
          <ParameterRefEntry parameterRef="mtq_dipole_y">
            <LocationInContainerInBits referenceLocation="containerStart">
              <FixedValue>168</FixedValue>
            </LocationInContainerInBits>
          </ParameterRefEntry>
          <ParameterRefEntry parameterRef="mtq_dipole_z">
            <LocationInContainerInBits referenceLocation="containerStart">
              <FixedValue>200</FixedValue>
            </LocationInContainerInBits>
          </ParameterRefEntry>
        </EntryList>
      </SequenceContainer>

