      <!-- TC(17,1) Are-You-Alive ping -->
      <!-- Binary: 6 primary + 5 secondary = 11 bytes         -->
      <!-- Primary:   1810 C000 0004                          -->
      <!-- Secondary: 11 11 01 00 00                          -->
      <MetaCommand name="TC_17_1_AreYouAlive">
        <LongDescription>Send S17 Are-You-Alive ping to OBC</LongDescription>
        <ArgumentList/>
        <CommandContainer name="TC_17_1_AreYouAlive_cc">
          <EntryList>
            <FixedValueEntry binaryValue="1810C00000041111010000" sizeInBits="88"/>
          </EntryList>
        </CommandContainer>
      </MetaCommand>

      <!-- TC(20,1) Set Parameter                                    -->
      <!-- Binary: 6 primary + 5 secondary + 6 app_data = 17 bytes  -->
      <!-- Primary:   1810 C000 000A                                 -->
      <!-- Secondary: 11 14 01 00 00                                 -->
      <!-- App data:  [param_id: uint16 BE] [value: float32 BE]      -->
      <MetaCommand name="TC_20_1_SetParameter">
        <LongDescription>Set on-board parameter value (S20)</LongDescription>
        <ArgumentList>
          <Argument name="parameter_id" argumentTypeRef="uint16_arg"/>
          <Argument name="value" argumentTypeRef="float32_arg"/>
        </ArgumentList>
        <CommandContainer name="TC_20_1_SetParameter_cc">
          <EntryList>
            <FixedValueEntry binaryValue="1810C000000A1114010000" sizeInBits="88"/>
            <ArgumentRefEntry argumentRef="parameter_id"/>
            <ArgumentRefEntry argumentRef="value"/>
          </EntryList>
        </CommandContainer>
      </MetaCommand>

      <!-- TC(20,1) Set B-dot gain  -  convenience: parameter_id=0x20A0 hardcoded -->
      <MetaCommand name="TC_20_1_SetBdotGain">
        <LongDescription>Set B-dot controller gain k_bdot (S20, ID=0x20A0)  -  visible in TM(3,25) AOCS_HK + TM(20,2)</LongDescription>
        <ArgumentList>
          <Argument name="value" argumentTypeRef="float32_arg"/>
        </ArgumentList>
        <CommandContainer name="TC_20_1_SetBdotGain_cc">
          <EntryList>
            <FixedValueEntry binaryValue="1810C000000A1114010000" sizeInBits="88"/>
            <FixedValueEntry binaryValue="20A0" sizeInBits="16"/>
            <ArgumentRefEntry argumentRef="value"/>
          </EntryList>
        </CommandContainer>
      </MetaCommand>

      <!-- TC(20,3) Get BdotGain  -  param_id=0x20A0 hardcoded, no args -->
      <!-- Primary:   1810 C000 0006 (length=6: 5B secondary + 2B data - 1) -->
      <!-- Secondary: 11 14 03 00 00 (PUS-A, svc=20, subsvc=3, src_id=0)    -->
      <!-- App data:  20 A0 (param_id=0x20A0)                                -->
      <MetaCommand name="TC_20_3_GetBdotGain">
        <LongDescription>Read B-dot controller gain k_bdot (S20, ID=0x20A0)  -  reply: TM(20,2)</LongDescription>
        <ArgumentList/>
        <CommandContainer name="TC_20_3_GetBdotGain_cc">
          <EntryList>
            <FixedValueEntry binaryValue="1810C0000006111403000020A0" sizeInBits="104"/>
          </EntryList>
        </CommandContainer>
      </MetaCommand>

    </MetaCommandSet>
