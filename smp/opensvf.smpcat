<?xml version="1.0" encoding="UTF-8"?>
<!--
  opensvf SMP-aligned model catalogue
  Generated by tools/generate_smpcat.py
  Date: 2026-10-25
  Aligned with: ECSS-E-ST-40-07C (Simulation Modelling Platform)
  Not SMDL-conformant: not valid against XML/Smdl/Catalogue.xsd
-->
<Catalogue
  xmlns="urn:opensvf:smp-aligned:1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  Title="opensvf model catalogue"
  Creator="opensvf tools/generate_smpcat.py"
  Date="2026-10-25"
  Version="1.0.0">

  <Package Name="opensvf" Creator="opensvf">

    <Package Name="aocs">
      <Model Name="attitude">
        <Field Name="quaternion_w" Type="Float64" Kind="Output" Description="Attitude quaternion scalar component"/>
        <Field Name="quaternion_x" Type="Float64" Kind="Output" Description="Attitude quaternion X component"/>
        <Field Name="quaternion_y" Type="Float64" Kind="Output" Description="Attitude quaternion Y component"/>
        <Field Name="quaternion_z" Type="Float64" Kind="Output" Description="Attitude quaternion Z component"/>
      </Model>
      <Model Name="body">
        <Field Name="b_true_x" Type="Float64" Kind="Output" Unit="T" Description="True B-field in body frame X - internal sim port, wires to mag.true_x"/>
        <Field Name="b_true_y" Type="Float64" Kind="Output" Unit="T" Description="True B-field in body frame Y - internal sim port, wires to mag.true_y"/>
        <Field Name="b_true_z" Type="Float64" Kind="Output" Unit="T" Description="True B-field in body frame Z - internal sim port, wires to mag.true_z"/>
        <Field Name="omega_norm" Type="Float64" Kind="Output" Unit="rad/s" Description="True body angular velocity magnitude (rad/s)"/>
        <Field Name="omega_x" Type="Float64" Kind="Output" Unit="rad/s" Description="True body angular velocity X (rad/s)"/>
        <Field Name="omega_y" Type="Float64" Kind="Output" Unit="rad/s" Description="True body angular velocity Y (rad/s)"/>
        <Field Name="omega_z" Type="Float64" Kind="Output" Unit="rad/s" Description="True body angular velocity Z (rad/s)"/>
      </Model>
      <Model Name="css">
        <Field Name="illumination" Type="Float64" Kind="Input" Description="CSS illumination fraction input (0=eclipse, 1=full sun)"/>
        <Field Name="sun_x" Type="Float64" Kind="Output" Description="Sun vector X component (body frame, normalised)"/>
        <Field Name="sun_y" Type="Float64" Kind="Output" Description="Sun vector Y component (body frame, normalised)"/>
        <Field Name="sun_z" Type="Float64" Kind="Output" Description="Sun vector Z component (body frame, normalised)"/>
        <Field Name="validity" Type="Float64" Kind="Output" Description="CSS validity (0=invalid/eclipse, 1=valid)"/>
      </Model>
      <Model Name="ctrl">
        <Field Name="bdot_gain" Type="Float64" Kind="Input" Unit="Am2.s/T" Description="B-dot controller gain k_bdot  -  m_cmd = -k * B_dot [Am2*s/T]"/>
        <Field Name="bdot_max_dipole" Type="Float64" Kind="Input" Unit="Am2" Description="B-dot controller dipole saturation limit [Am2]"/>
      </Model>
      <Model Name="fdir">
        <Field Name="rate_ool_high" Type="Float64" Kind="Input" Unit="rad/s" Description="Body rate OOL high threshold  -  safe mode trigger [rad/s]"/>
        <Field Name="rate_ool_low" Type="Float64" Kind="Input" Unit="rad/s" Description="Body rate OOL low threshold  -  safe mode trigger [rad/s]"/>
        <Field Name="rw_speed_ool_high" Type="Float64" Kind="Input" Unit="rad/s" Description="Reaction wheel overspeed OOL threshold [rad/s]"/>
      </Model>
      <Model Name="gyro">
        <Field Name="power_enable" Type="Float64" Kind="Input" Description="Gyroscope power enable (0=off, 1=on)"/>
        <Field Name="rate_x" Type="Float64" Kind="Output" Unit="rad/s" Description="Measured angular rate X axis"/>
        <Field Name="rate_y" Type="Float64" Kind="Output" Unit="rad/s" Description="Measured angular rate Y axis"/>
        <Field Name="rate_z" Type="Float64" Kind="Output" Unit="rad/s" Description="Measured angular rate Z axis"/>
        <Field Name="status" Type="Float64" Kind="Output" Description="Gyroscope status (0=off, 1=nominal, 2=fault)"/>
        <Field Name="temperature" Type="Float64" Kind="Output" Unit="degC" Description="Gyroscope temperature"/>
      </Model>
      <Model Name="mag">
        <Field Name="field_x" Type="Float64" Kind="Output" Unit="T" Description="Measured magnetic field X component"/>
        <Field Name="field_y" Type="Float64" Kind="Output" Unit="T" Description="Measured magnetic field Y component"/>
        <Field Name="field_z" Type="Float64" Kind="Output" Unit="T" Description="Measured magnetic field Z component"/>
        <Field Name="power_enable" Type="Float64" Kind="Input" Description="Magnetometer power enable (0=off, 1=on)"/>
        <Field Name="status" Type="Float64" Kind="Output" Description="Magnetometer status (0=off, 1=nominal, 2=fault)"/>
      </Model>
      <Model Name="mode">
        <Field Name="mode" Type="Float64" Kind="Output" Description="AOCS operating mode (0=safe, 1=detumbling, 2=nadir, 3=target)"/>
      </Model>
      <Model Name="mode_cmd">
        <Field Name="mode_cmd" Type="Float64" Kind="Input" Description="AOCS mode command (0=safe, 1=detumbling, 2=nadir, 3=target)"/>
      </Model>
      <Model Name="mtq">
        <Field Name="dipole_x" Type="Float64" Kind="Input" Unit="Am2" Description="Magnetorquer dipole moment X axis command"/>
        <Field Name="dipole_y" Type="Float64" Kind="Input" Unit="Am2" Description="Magnetorquer dipole moment Y axis command"/>
        <Field Name="dipole_z" Type="Float64" Kind="Input" Unit="Am2" Description="Magnetorquer dipole moment Z axis command"/>
        <Field Name="power_enable" Type="Float64" Kind="Input" Description="Magnetorquer power enable (0=off, 1=on)"/>
        <Field Name="status" Type="Float64" Kind="Output" Description="Magnetorquer status (0=off, 1=nominal)"/>
      </Model>
      <Model Name="rate">
        <Field Name="x" Type="Float64" Kind="Output" Unit="rad/s" Description="Angular rate around X axis"/>
        <Field Name="y" Type="Float64" Kind="Output" Unit="rad/s" Description="Angular rate around Y axis"/>
        <Field Name="z" Type="Float64" Kind="Output" Unit="rad/s" Description="Angular rate around Z axis"/>
      </Model>
      <Model Name="rw1">
        <Field Name="speed" Type="Float64" Kind="Output" Unit="rpm" Description="Reaction wheel 1 speed"/>
        <Field Name="status" Type="Float64" Kind="Output" Description="Reaction wheel 1 status (1=nominal)"/>
        <Field Name="temperature" Type="Float64" Kind="Output" Unit="degC" Description="Reaction wheel 1 bearing temperature"/>
        <Field Name="torque_cmd" Type="Float64" Kind="Input" Unit="Nm" Description="Reaction wheel 1 torque command"/>
      </Model>
      <Model Name="str1">
        <Field Name="acquisition_progress" Type="Float64" Kind="Output" Description="Star tracker 1 acquisition progress (0.0 to 1.0)"/>
        <Field Name="mode" Type="Float64" Kind="Output" Description="Star tracker 1 mode (0=off, 1=acquiring, 2=tracking)"/>
        <Field Name="power_enable" Type="Float64" Kind="Input" Description="Star tracker 1 power enable command (0=off, 1=on)"/>
        <Field Name="quaternion_w" Type="Float64" Kind="Output" Description="Star tracker 1 attitude quaternion scalar component"/>
        <Field Name="quaternion_x" Type="Float64" Kind="Output" Description="Star tracker 1 attitude quaternion X component"/>
        <Field Name="quaternion_y" Type="Float64" Kind="Output" Description="Star tracker 1 attitude quaternion Y component"/>
        <Field Name="quaternion_z" Type="Float64" Kind="Output" Description="Star tracker 1 attitude quaternion Z component"/>
        <Field Name="sun_angle" Type="Float64" Kind="Input" Unit="deg" Description="Star tracker 1 sun angle input (for blinding detection)"/>
        <Field Name="temperature" Type="Float64" Kind="Output" Unit="degC" Description="Star tracker 1 detector temperature"/>
        <Field Name="validity" Type="Float64" Kind="Output" Description="Star tracker 1 measurement validity (0=invalid, 1=valid)"/>
      </Model>
      <Model Name="truth">
        <Field Name="rate_x" Type="Float64" Kind="Input" Unit="rad/s" Description="True angular rate X (input to sensor models)"/>
        <Field Name="rate_y" Type="Float64" Kind="Input" Unit="rad/s" Description="True angular rate Y (input to sensor models)"/>
        <Field Name="rate_z" Type="Float64" Kind="Input" Unit="rad/s" Description="True angular rate Z (input to sensor models)"/>
      </Model>
    </Package>

    <Package Name="dhs">
      <Model Name="obc">
        <Field Name="cpu_load" Type="Float64" Kind="Output" Unit="%" Description="OBC CPU load percentage"/>
        <Field Name="health" Type="Float64" Kind="Output" Description="OBC health status (0=nominal, 1=degraded, 2=failed)"/>
        <Field Name="memory_dump_cmd" Type="Float64" Kind="Input" Description="Mass memory dump command (1=initiate dump)"/>
        <Field Name="memory_used_pct" Type="Float64" Kind="Output" Unit="%" Description="Mass memory used percentage"/>
        <Field Name="mode" Type="Float64" Kind="Output" Description="OBC operating mode (0=safe, 1=nominal, 2=payload)"/>
        <Field Name="mode_cmd" Type="Float64" Kind="Input" Description="OBC mode transition command"/>
        <Field Name="obt" Type="Float64" Kind="Output" Unit="s" Description="On-board time in seconds since epoch"/>
        <Field Name="reset_count" Type="Float64" Kind="Output" Description="OBC reset counter since launch"/>
        <Field Name="watchdog_kick" Type="Float64" Kind="Input" Description="Watchdog kick command (write 1 to reset timer)"/>
        <Field Name="watchdog_status" Type="Float64" Kind="Output" Description="Watchdog status (0=nominal, 1=timeout_warning, 2=reset)"/>
      </Model>
    </Package>

    <Package Name="eps">
      <Model Name="battery">
        <Field Name="charge_current" Type="Float64" Kind="Output" Unit="A" Description="Battery charge current. Positive = charging, negative = discharging."/>
        <Field Name="soc" Type="Float64" Kind="Output" Description="Battery state of charge"/>
        <Field Name="voltage" Type="Float64" Kind="Output" Unit="V" Description="Battery terminal voltage"/>
      </Model>
      <Model Name="bus">
        <Field Name="voltage" Type="Float64" Kind="Output" Unit="V" Description="Regulated power bus voltage"/>
      </Model>
      <Model Name="load">
        <Field Name="power" Type="Float64" Kind="Input" Unit="W" Description="Spacecraft load power demand"/>
      </Model>
      <Model Name="pcdu">
        <Field Name="charge_current" Type="Float64" Kind="Output" Unit="A" Description="Battery charge current commanded by PCDU"/>
        <Field Name="lcl1.enable" Type="Float64" Kind="Input" Description="LCL1 enable command (0=off, 1=on)"/>
        <Field Name="lcl1.status" Type="Float64" Kind="Output" Description="LCL1 status (0=off, 1=on)"/>
        <Field Name="lcl2.enable" Type="Float64" Kind="Input" Description="LCL2 enable command (0=off, 1=on)"/>
        <Field Name="lcl2.status" Type="Float64" Kind="Output" Description="LCL2 status (0=off, 1=on)"/>
        <Field Name="lcl3.enable" Type="Float64" Kind="Input" Description="LCL3 enable command (0=off, 1=on)"/>
        <Field Name="lcl3.status" Type="Float64" Kind="Output" Description="LCL3 status (0=off, 1=on)"/>
        <Field Name="lcl4.enable" Type="Float64" Kind="Input" Description="LCL4 enable command (0=off, 1=on)"/>
        <Field Name="lcl4.status" Type="Float64" Kind="Output" Description="LCL4 status (0=off, 1=on)"/>
        <Field Name="lcl5.enable" Type="Float64" Kind="Input" Description="LCL5 enable command (0=off, 1=on)"/>
        <Field Name="lcl5.status" Type="Float64" Kind="Output" Description="LCL5 status (0=off, 1=on)"/>
        <Field Name="lcl6.enable" Type="Float64" Kind="Input" Description="LCL6 enable command (0=off, 1=on)"/>
        <Field Name="lcl6.status" Type="Float64" Kind="Output" Description="LCL6 status (0=off, 1=on)"/>
        <Field Name="lcl7.enable" Type="Float64" Kind="Input" Description="LCL7 enable command (0=off, 1=on)"/>
        <Field Name="lcl7.status" Type="Float64" Kind="Output" Description="LCL7 status (0=off, 1=on)"/>
        <Field Name="lcl8.enable" Type="Float64" Kind="Input" Description="LCL8 enable command (0=off, 1=on)"/>
        <Field Name="lcl8.status" Type="Float64" Kind="Output" Description="LCL8 status (0=off, 1=on)"/>
        <Field Name="mppt_efficiency" Type="Float64" Kind="Output" Description="MPPT efficiency (0.0-1.0)"/>
        <Field Name="total_load" Type="Float64" Kind="Output" Unit="W" Description="Total spacecraft load power"/>
        <Field Name="uvlo_active" Type="Float64" Kind="Output" Description="Under-voltage lockout active (0=nominal, 1=UVLO)"/>
      </Model>
      <Model Name="solar_array">
        <Field Name="efficiency" Type="Float64" Kind="Output" Description="Solar array efficiency relative to STC (0–1)"/>
        <Field Name="generated_current" Type="Float64" Kind="Output" Unit="A" Description="Solar array output current at MPP"/>
        <Field Name="generated_power" Type="Float64" Kind="Output" Unit="W" Description="Solar array generated power at MPP"/>
        <Field Name="generated_voltage" Type="Float64" Kind="Output" Unit="V" Description="Solar array MPP voltage"/>
        <Field Name="illumination" Type="Float64" Kind="Input" Description="Solar illumination fraction (0.0=eclipse, 1.0=full sun)"/>
        <Field Name="panel_temp_degc" Type="Float64" Kind="Input" Unit="degC" Description="Solar panel temperature"/>
      </Model>
    </Package>

    <Package Name="thermal">
      <Model Name="battery">
        <Field Name="temperature" Type="Float64" Kind="Output" Unit="degC" Description="Battery pack temperature"/>
      </Model>
      <Model Name="heater">
        <Field Name="battery_cmd" Type="Float64" Kind="Input" Description="Battery heater enable command (0=off, 1=on)"/>
        <Field Name="battery_status" Type="Float64" Kind="Output" Description="Battery heater status (0=off, 1=on)"/>
        <Field Name="obc_cmd" Type="Float64" Kind="Input" Description="OBC heater enable command (0=off, 1=on)"/>
      </Model>
      <Model Name="obc">
        <Field Name="temperature" Type="Float64" Kind="Output" Unit="degC" Description="OBC board temperature"/>
      </Model>
      <Model Name="solar_panel">
        <Field Name="temperature" Type="Float64" Kind="Output" Unit="degC" Description="Solar panel temperature"/>
      </Model>
      <Model Name="structure">
        <Field Name="temperature" Type="Float64" Kind="Output" Unit="degC" Description="Spacecraft structure temperature"/>
      </Model>
    </Package>

    <Package Name="ttc">
      <Model Name="sbt">
        <Field Name="downlink_active" Type="Float64" Kind="Output" Description="S-Band downlink active (0=inactive, 1=active)"/>
        <Field Name="mode" Type="Float64" Kind="Output" Description="SBT operating mode (0=idle, 1=ranging, 2=tc_rx, 3=tm_tx)"/>
        <Field Name="mode_cmd" Type="Float64" Kind="Input" Description="SBT mode command (0=idle, 1=ranging, 2=tc_rx, 3=tm_tx)"/>
        <Field Name="power_enable" Type="Float64" Kind="Input" Description="SBT power enable command (0=off, 1=on)"/>
        <Field Name="rx_bitrate" Type="Float64" Kind="Output" Unit="bps" Description="Uplink bit rate"/>
        <Field Name="tx_bitrate" Type="Float64" Kind="Output" Unit="bps" Description="Downlink bit rate"/>
        <Field Name="uplink_lock" Type="Float64" Kind="Output" Description="S-Band uplink carrier lock (0=unlocked, 1=locked)"/>
        <Field Name="uplink_signal_level" Type="Float64" Kind="Input" Unit="dBm" Description="S-Band uplink received signal level"/>
      </Model>
    </Package>

  </Package>

</Catalogue>
